{
  "id": "fourplay",
  "name": "Fourplay",
  "description": "New puzzles daily! Given sixteen words, find the four groups of four that belong together. Submit your own groups and see them featured in future puzzles! Share your score over SMS with friends and compete to be the smartest every day!",
  "lang": "en-US",
  "theme_color": "#b0b0ae",
  "orientation": "natural",
